{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Sthin window may do. Serve is reached only through the app's own serve_call command; the webview has no shell access.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:tray:default",
    "core:menu:default",
    "notification:default",
    "opener:default"
  ]
}
